# STAYQEN Backend Configuration
PROJECT_NAME="STAYQEN Shared Project Memory"
ENVIRONMENT=development
PORT=8000

# FalkorDB Graph Database
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_PASSWORD=
FALKORDB_GRAPH=stayqen_memory

# Google Gemini API (Optional - deterministic rule engine operates automatically if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
